# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# Local MongoDB, or an Atlas connection string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/lifegrid

# Any long random string. Rotate before going to production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (your frontend's
# dev server and production URL).
CORS_ORIGIN=http://localhost:5173
